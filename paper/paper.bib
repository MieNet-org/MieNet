@article{sumlin_retrieving_2018,
	title = {Retrieving the aerosol complex refractive index using {PyMieScatt}: {A} {Mie} computational package with visualization capabilities},
	volume = {205},
	issn = {0022-4073},
	shorttitle = {Retrieving the aerosol complex refractive index using {PyMieScatt}},
	url = {https://www.sciencedirect.com/science/article/pii/S0022407317305836},
	doi = {10.1016/j.jqsrt.2017.10.012},
	abstract = {The complex refractive index m = n + ik of a particle is an intrinsic property which cannot be directly measured; it must be inferred from its extrinsic properties such as the scattering and absorption cross-sections. Bohren and Huffman called this approach “describing the dragon from its tracks”, since the inversion of Lorenz-Mie theory equations is intractable without the use of computers. This article describes PyMieScatt, an open-source module for Python that contains functionality for solving the inverse problem for complex m using extensive optical and physical properties as input, and calculating regions where valid solutions may exist within the error bounds of laboratory measurements. Additionally, the module has comprehensive capabilities for studying homogeneous and coated single spheres, as well as ensembles of homogeneous spheres with user-defined size distributions, making it a complete tool for studying the optical behavior of spherical particles.},
	urldate = {2026-08-03},
	journal = {Journal of Quantitative Spectroscopy and Radiative Transfer},
	author = {Sumlin, Benjamin J. and Heinson, William R. and Chakrabarty, Rajan K.},
	month = jan,
	year = {2018},
	keywords = {Aerosol optics, Electromagnetic scattering and absorption, Mie theory, Open-source software, Python 3},
	pages = {127--134},
	file = {ScienceDirect Snapshot:/Users/daisyattaway/Zotero/storage/QD99XVP3/S0022407317305836.html:text/html;Submitted Version:/Users/daisyattaway/Zotero/storage/IMEWLXBC/Sumlin et al. - 2018 - Retrieving the aerosol complex refractive index using PyMieScatt A Mie computational package with v.pdf:application/pdf},
}

@misc{hedman_features_2026,
	title = {Features in the visible spectra of the {Enceladus} particle plume and {E} ring: {Potential} evidence of organic materials and/or missing sub-micron particles},
	shorttitle = {Features in the visible spectra of the {Enceladus} particle plume and {E} ring},
	url = {https://ui.adsabs.harvard.edu/abs/2026arXiv260715940H},
	doi = {10.48550/arXiv.2607.15940},
	abstract = {Visible spectra of the Enceladus particle plume and E ring contain evidence for a change in spectral slope around 0.5 micron. This feature can be seen in data obtained by both the Visual and Infrared Mapping Spectrometer (VIMS) and Imaging Science Subsystem (ISS) onboard the Cassini Spacecraft, and is consistent with the slope change seen in the surface spectra of Saturn's rings and moons that has been attributed to either organics or iron compounds. The observed spectral features in the plume and E ring could represent either a non-ice contaminant in the plume particles or a deficit of sub-micron particles, so this spectral feature provides a new tool for assessing variations in the plume particle's composition and/or size distribution with time and space. The observed strength of this feature is consistent with the plume particles having an organic fraction similar to that measured by in-situ measurements, so there are good reasons to expect that this feature can be used to quantify the organic content of the plume particles. There are also hints of a potential absorption band around 0.45 micron in these spectra. If this feature can be confirmed, it could provide further constraints on the plume particles' composition.},
	urldate = {2026-08-12},
	publisher = {arXiv},
	author = {Hedman, M. M. and MacKenzie, S. M.},
	month = jul,
	year = {2026},
	note = {ADS Bibcode: 2026arXiv260715940H},
	keywords = {Earth and Planetary Astrophysics},
	file = {Full Text PDF:/Users/daisyattaway/Zotero/storage/8SYJYKJH/Hedman and MacKenzie - 2026 - Features in the visible spectra of the Enceladus particle plume and E ring Potential evidence of or.pdf:application/pdf},
}

@article{ji_mechanism_2026,
	title = {Mechanism of heterogeneous mixing between typical oxygenated volatile organic compound and hematite: implication for radiative forcing},
	volume = {380},
	issn = {1352-2310},
	shorttitle = {Mechanism of heterogeneous mixing between typical oxygenated volatile organic compound and hematite},
	url = {https://ui.adsabs.harvard.edu/abs/2026AtmEn.38022089J},
	doi = {10.1016/j.atmosenv.2026.122089},
	abstract = {Atmospheric mineral particles undergo chemical aging via mixing with atmospheric organic compounds, leading to significant modification of their physicochemical properties and thereby altering their climatic effects. In this work, we performed density functional theory (DFT) calculations to investigate the mixing mechanisms of glyoxal (GL) and its hydrate products with hematite (α-Fe2O3) and their impact on radiative effects. The stable heterocomplexes of GL with α-Fe2O3 are formed via O─Fe covalent bonding, dominantly in a bridging bidentate mode. Owing to the presence of hydroxyl groups, hydrate products of GL exhibit a stronger interaction with α-Fe2O3 surface, attributable to the formation of stronger O─Fe covalent bonds. However, the interaction is weakened by the hydroxylation of α-Fe2O3, since steric hindrance introduced by interfacial hydroxyl groups on Fe sites hinders the formation of O─Fe covalent bonds. Radiative effects analysis reveals that the warming effect of pristine α-Fe2O3 is enhanced by the mixing with GL, whereas the enhancement is reduced by GL hydration and hydroxylation of α-Fe2O3. Our results reveal that the climatic effects of mineral particles are dynamically modulated by surface organic composition and ambient humidity, highlighting that a mechanistic understanding of interfacial chemical aging is essential for climate models to accurately assess the climatic effects of mineral particles.},
	urldate = {2026-08-12},
	journal = {Atmospheric Environment},
	publisher = {Elsevier},
	author = {Ji, Yongpeng and Kong, Linghao and Wang, Jiaxin and Zhao, Baocong and Zhang, Zhiming and Chen, Shengping and Lin, Sihao and Chen, Jiangyao and Gao, Yanpeng and Ji, Yuemeng},
	month = sep,
	year = {2026},
	note = {ADS Bibcode: 2026AtmEn.38022089J},
	pages = {122089},
}

